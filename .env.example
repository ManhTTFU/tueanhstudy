# Chuỗi kết nối Neon PostgreSQL (dùng chuỗi "Pooled connection").
# Bỏ trống khi chạy local => ứng dụng tự dùng PGlite lưu tại thư mục .data/ (chỉ dành cho dev).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Chuỗi kết nối TRỰC TIẾP (không có "-pooler") – chỉ dùng cho migration / drizzle-kit. Không cần đặt trên Vercel.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# (Tuỳ chọn) Khoá bí mật ký cookie đăng nhập (gia đình + phụ huynh). Nếu bỏ trống, hệ thống tự sinh và lưu trong database.
PARENT_SESSION_SECRET=""

# Mã mời để tạo gia đình mới (từ gia đình thứ 2 trở đi). Bỏ trống => đóng đăng ký.
FAMILY_INVITE_CODE=""
# (Tuỳ chọn) Số gia đình tối đa, mặc định 10.
MAX_FAMILIES=""
